<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>14</LangVersion>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
      <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
      <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\SilkyNvg\SilkyNvg.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Silk.NET.OpenGL" Version="2.23.0" />
    </ItemGroup>

    <ItemGroup>
      <None Remove="Shaders\ShaderCode\paintingShader.frag.glsl" />
      <None Remove="Shaders\ShaderCode\paintingShader.vert.glsl" />
      <None Remove="Shaders\ShaderCode\anchorGeometryShader.frag.glsl" />
      <None Remove="Shaders\ShaderCode\anchorGeometryShader.vert.glsl" />
    </ItemGroup>

    <ItemGroup>
      <None Remove="Shaders\ShaderCode\shader.frag.glsl" />
      <EmbeddedResource Include="Shaders\ShaderCode\shader.frag.glsl" />
      <None Remove="Shaders\ShaderCode\shader.vert.glsl" />
      <EmbeddedResource Include="Shaders\ShaderCode\shader.vert.glsl" />
      <None Remove="Shaders\ShaderCode\debug.vert.glsl" />
      <EmbeddedResource Include="Shaders\ShaderCode\debug.vert.glsl" />
      <None Remove="Shaders\ShaderCode\debug.frag.glsl" />
      <EmbeddedResource Include="Shaders\ShaderCode\debug.frag.glsl" />
    </ItemGroup>

</Project>
